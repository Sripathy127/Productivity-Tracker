# ---------------------------------------------------------------------------
# Productivity Tracker - backend configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# SQLite (default for local development without Docker)
DATABASE_URL=sqlite:///./productivity_tracker.db

# Postgres (used by docker compose; switch to this once Docker is available)
# DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/productivity_tracker

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 to log emitted SQL statements.
SQL_ECHO=0

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# OAuth 2.0 *Web application* client ID from Google Cloud Console. This value
# is public (it is served to the browser); the client SECRET is not used by
# this flow and must not be placed here. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Signing key for this API's own session cookie. Generate a long random value
# for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-insecure-session-secret

# Session lifetime in hours (default 336 = 14 days).
SESSION_TTL_HOURS=336

# Set to 1 only when the API is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Local escape hatch: treat every unauthenticated request as a fixed local
# account, so the app is usable before Google credentials exist.
# MUST be 0 in any deployment.
AUTH_DEV_BYPASS=1
DEV_USER_EMAIL=local@productivity.tracker
DEV_USER_NAME=Local User
